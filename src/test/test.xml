<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  PropFind – TestNG Suite
  Run all tests:  mvn test
  Override site:  mvn test -DbaseUrl=http://localhost:8080/
-->
<suite name="PropFind" verbose="1" parallel="false">

    <!-- Extent Reports listener – generates target/extent-reports/ExtentReport_<timestamp>.html -->
    <listeners>
        <listener class-name="ExtentReportListener"/>
    </listeners>

    <!-- Optional: override the base URL for all tests at once -->
    <parameter name="baseUrl" value=""/>

    <!-- ─────────────────────────────────────────────────────────
         US01  Login / Register  (Raman)
         Runner: LoginTest (Cucumber/TestNG via AbstractTestNGCucumberTests)
         Feature: src/test/resources/features/Login.feature
    ───────────────────────────────────────────────────────────── -->
    <!-- US01 Login / Register (Raman) -->
<!--
<test name="Login Tests">
    <classes>
        <class name="LoginTest"/>
    </classes>
</test>
-->
   
    <!-- ─────────────────────────────────────────────────────────
         US05, US06  Property Detail – Part A  (Rahul)
         Runner: PropertyDetailTest
         Feature: src/test/resources/features/PropertyDetail.feature
    ───────────────────────────────────────────────────────────── -->
  

    <!-- ─────────────────────────────────────────────────────────
         US08  Compare Properties  (Nithyasri)
         Runner: CompareTest
         Feature: src/test/resources/features/Compare.feature
    ───────────────────────────────────────────────────────────── -->
    <test name="Compare Tests">
        <classes>
            <class name="CompareTest"/>
        </classes>
    </test>

    <!-- ─────────────────────────────────────────────────────────
         US12  Budget Planner  (Nithyasri)
