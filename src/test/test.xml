<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<!--
    baseUrl is OPTIONAL — when omitted, BaseTest resolves it automatically
    to src/test/resources/TargetWebsite/ relative to the project root.
    Only set it here if you want to override with a custom path, e.g.:
    <parameter name="baseUrl" value="file:///C:/Users/YourName/.../TargetWebsite/"/>
-->
<suite name="PropFind-Suite" verbose="1">

    <listeners>
        <listener class-name="reporter.TestListener"/>
    </listeners>

    <parameter name="headless" value="false"/>

    <test name="PropFind-Tests">
        <packages>
            <package name="tests"/>
        </packages>
    </test>

</suite>
