<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  PropFind – TestNG Suite
  Run all tests:  mvn test
  Override site:  mvn test -DbaseUrl=http://localhost:8080/
-->
<suite name="PropFind" verbose="1" parallel="false">

    <!-- Listeners -->
    <listeners>
        <listener class-name="com.propfind.listeners.ExtentReportListener"/>
        <!-- TestListener removed: it duplicated Extent Reports and was blind to
             Cucumber scenario-level results. Screenshots and pass/fail for Cucumber
             scenarios are captured per-scenario in each feature's Hooks class. -->
    </listeners>

    <!-- Optional overrides -->
    <parameter name="baseUrl"  value=""/>
    <parameter name="headless" value="false"/>

    <!-- ═══════════════════════════════════════════════════════════════
         US01  Login / Register  (Raman)
         Cucumber runner · Login.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Login Tests">
        <classes>
            <class name="com.propfind.runners.LoginTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US02  Smart Property Search
         US03  Advanced Property Filters  (Prabavathi)
         Plain TestNG · SearchResultsTest
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Search Results Tests">
        <classes>
            <class name="com.propfind.tests.SearchResultsTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US04  Map View  (Raman)
         Cucumber runner · MapView.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Map View Tests">
        <classes>
            <class name="com.propfind.runners.MapViewTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US05  Property Detail – Part A  (Rahul)
         US06  Property Detail – Part A  (Rahul)
         US09  Property Detail – Part B  (Rohit)
         US10  Property Detail – Part B  (Rohit)
         US14  Property Detail – Part B  (Rohit)
         Cucumber runner · PropertyDetail.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Property Detail Tests">
        <classes>
            <class name="com.propfind.runners.PropertyDetailTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US07  User Dashboard   (Nived)
         US11  Property Preferences  (Nived)
         Cucumber runner · Dashboard.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Dashboard Tests">
        <classes>
            <class name="com.propfind.runners.DashboardTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US07 / US11 plain TestNG cross-check  (Nived)
         Plain TestNG · DashboardTest
         Runs the same TC31–TC35, TC51–TC55 scenarios outside Cucumber.
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Dashboard Tests (plain TestNG)">
        <classes>
            <class name="com.propfind.tests.DashboardTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US08  Compare Properties  (Nithyasri)
         Cucumber runner · Compare.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Compare Tests">
        <classes>
            <class name="com.propfind.runners.CompareTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US12  Budget Planner  (Nithyasri)
         Cucumber runner · BudgetPlanner.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Budget Planner Tests">
        <classes>
            <class name="com.propfind.runners.BudgetPlannerTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US13  Add Listing  (Sherin)
         Cucumber runner · AddListing.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Add Listing Tests">
        <classes>
            <class name="com.propfind.runners.AddListingTest"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════════
         US15  Moving Assistant  (Sherin)
         Cucumber runner · MovingAssistant.feature
    ════════════════════════════════════════════════════════════════════ -->
    <test name="Moving Assistant Tests">
        <classes>
            <class name="com.propfind.runners.MovingAssistantTest"/>
        </classes>
    </test>

</suite>
