<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  PropFind – TestNG Suite
  Run all tests:  mvn test
  Override site:  mvn test -DbaseUrl=http://localhost:8080/
-->
<suite name="PropFind" verbose="1" parallel="false">

    <!-- Extent Reports listener – generates target/extent-reports/ExtentReport_<timestamp>.html -->
    <listeners>
        <listener class-name="com.propfind.listeners.ExtentReportListener"/>
    </listeners>

    <!-- Optional: override the base URL for all tests at once -->
    <parameter name="baseUrl" value=""/>
    <parameter name="headless" value="true"/>

    <!-- ─────────────────────────────────────────────────────────
         US01  Login / Register  (Raman)
         Runner: LoginTest (Cucumber/TestNG via AbstractTestNGCucumberTests)
         Feature: src/test/resources/features/Login.feature
    ───────────────────────────────────────────────────────────── -->
    <test name="Login Tests">
        <classes>
            <class name="com.propfind.runners.LoginTest"/>
        </classes>
    </test>

    <!-- ─────────────────────────────────────────────────────────
         US04  Map View  (Raman)
         Runner: MapViewTest (Cucumber/TestNG via AbstractTestNGCucumberTests)
         Feature: src/test/resources/features/MapView.feature
    ───────────────────────────────────────────────────────────── -->
    <test name="Map View Tests">
        <classes>
            <class name="com.propfind.runners.MapViewTest"/>
        </classes>
    </test>

    <!-- ─────────────────────────────────────────────────────────
         US02  Smart Property Search  (Prabavathi)
         TC06–TC10 — SearchResultsTest (TestNG)
    ───────────────────────────────────────────────────────────── -->
    <!-- ─────────────────────────────────────────────────────────
         US03  Advanced Property Filters  (Prabavathi)
         TC11–TC15 — SearchResultsTest (TestNG)
    ───────────────────────────────────────────────────────────── -->
    <test name="Search Results Tests (US02, US03)">
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.SearchResultsTest"/>
        </classes>
    </test>

    <!-- ─────────────────────────────────────────────────────────
         US07  User Dashboard  (Prabavathi)
         TC31–TC35 — DashboardTest (TestNG)
    ───────────────────────────────────────────────────────────── -->
    <!-- ─────────────────────────────────────────────────────────
         US11  Property Preferences  (Prabavathi)
         TC51–TC55 — DashboardTest (TestNG)
    ───────────────────────────────────────────────────────────── -->
    <test name="Dashboard Tests (US07, US11)">
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.DashboardTest"/>
        </classes>
    </test>

    <!-- ─────────────────────────────────────────────────────────
         US05, US06  Property Detail – Part A  (Rahul)
         Runner: PropertyDetailTest
         Feature: src/test/resources/features/PropertyDetail.feature
    ─────────────────────────────────────────────────────────────
    <test name="Property Detail Tests">
        <classes>
            <class name="com.propfind.runners.PropertyDetailTest"/>
        </classes>
    </test>-->

</suite>
