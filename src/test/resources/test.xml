<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  PropFind – TestNG Suite
  Run all tests:  mvn test
  Override site:  mvn test -DbaseUrl=http://localhost:8080/
-->

<suite name="PropFind" verbose="1" parallel="false">

    <!-- Extent Reports listener -->
    <listeners>
        <listener class-name="com.propfind.listeners.ExtentReportListener"/>
    </listeners>

    <!-- Global parameters -->
    <parameter name="baseUrl" value=""/>
    <parameter name="headless" value="true"/>

    <!-- =========================================================
         US01 Login / Register (Raman)
         Runner: LoginTest
    ========================================================== -->
    <test name="Login Tests">
        <classes>
            <class name="com.propfind.runners.LoginTest"/>
        </classes>
    </test>

    <!-- =========================================================
         US04 Map View (Raman)
         Runner: MapViewTest
    ========================================================== -->
    <test name="Map View Tests">
        <classes>
            <class name="com.propfind.runners.MapViewTest"/>
        </classes>
    </test>

    <!-- =========================================================
         US02 Smart Property Search
         US03 Advanced Property Filters
         TC06-TC15
    ========================================================== -->
    <test name="Search Results Tests (US02, US03)">
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.SearchResultsTest"/>
        </classes>
    </test>

    <!-- =========================================================
         US07 User Dashboard
         US11 Property Preferences
         TC31-TC55
    ========================================================== -->
     <test name="Dashboard Tests (US07, US11)">
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.DashboardTest"/>
        </classes>
    </test>


    <!-- =========================================================
         US05, US06 Property Detail – Part A (Rahul)
         US09, US10, US14 Property Detail – Part B (Rohit)
         Runner: PropertyDetailTest
         Feature: src/test/resources/features/PropertyDetail.feature
    ========================================================== -->
     <test name="Property Detail Tests">
        <classes>
            <class name="com.propfind.runners.PropertyDetailTest"/>
        </classes>
    </test>

    <!--<test name="Search Results Tests">
        <classes>
            <class name="com.propfind.runners.SearchResultsTest"/>
        </classes>
    </test>-->
    <!-- =========================================================
         US08 Compare Properties (Nithyasri)
         Runner: CompareTest
         Feature: src/test/resources/features/Compare.feature
    ========================================================== -->

    <test name="Compare Tests">
        <classes>
            <class name="com.propfind.runners.CompareTest"/>
        </classes>
    </test>

    <!-- =========================================================
         US12 Budget Planner (Nithyasri)
         Runner: BudgetPlannerTest
         Feature: src/test/resources/features/BudgetPlanner.feature
    ========================================================== -->
    <test name="Budget Planner Tests">
        <classes>
            <class name="com.propfind.runners.BudgetPlannerTest"/>
        </classes>
    </test>

</suite>